# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Commander-Z3R0

pkgname=device-pine64-pinephonepro-marathon
pkgdesc="PINE64 PinePhone Pro device package for Marathon OS"
pkgver=1.0.0
pkgrel=2
url="https://github.com/patrickjquinn/Marathon-Shell"
license="Apache-2.0"
arch="aarch64"
options="!check !archcheck"
# device-pine64-pinephonepro (pmaports) brings the DTBs, the modem stack
# (eg25-manager), the kernel and U-Boot; the pipeline's U-Boot boot path
# lays out the disk. Call audio is WirePlumber's: the "Voice Call" UCM
# verb during a ModemManager call. Bring-up: not validated on hardware.
depends="
	device-pine64-pinephonepro
	marathon-shell
	marathon-base-config
	marathon-plymouth-theme
	plymouth
	u-boot-tools
"
install="$pkgname.post-install"
source="
	greetd-marathon.toml
	logind.conf
	device-profile.conf
	marathon-boot.cmd
	"

package() {
	# greetd autologin with the PinePhone Pro display environment (DPI,
	# no MSAA layers). The post-install points /etc/greetd/config.toml,
	# owned by marathon-base-config, at it.
	install -Dm644 "$srcdir/greetd-marathon.toml" \
		"$pkgdir/etc/greetd/marathon-config.toml"

	# The shell handles the power key (lock / power menu). Left to
	# logind's default, a press powers the phone off.
	install -Dm644 "$srcdir/logind.conf" \
		"$pkgdir/etc/systemd/logind.conf.d/50-marathon.conf"

	# Generated from devices/pine64/pinephonepro/device.toml.
	install -Dm644 "$srcdir/device-profile.conf" \
		"$pkgdir/etc/marathon/device-profile.conf"

	# U-Boot script with splash enabled. mkosi.finalize compiles it to
	# /boot/boot.scr with mkimage (u-boot-tools), replacing the stock one.
	install -Dm644 "$srcdir/marathon-boot.cmd" \
		"$pkgdir/usr/share/marathon/marathon-boot.cmd"
}

sha512sums="
